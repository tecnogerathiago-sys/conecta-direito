DATABASE_URL="postgresql://user:password@localhost:5432/conecta_direito?schema=public"
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"

# Mercado Pago — assinaturas recorrentes (PreApproval, cartão) e Pix avulso.
# Access Token / Public Key: Painel de Desenvolvedores > sua aplicação > Credenciais de teste/produção.
MERCADOPAGO_ACCESS_TOKEN=""
MERCADOPAGO_PUBLIC_KEY=""
# Webhook secret: Painel de Desenvolvedores > sua aplicação > Webhooks > "Assinatura secreta".
# É a mesma para os modos de teste e produção.
MERCADOPAGO_WEBHOOK_SECRET=""
# Ids dos planos (PreApprovalPlan) — criados uma vez via API, um por plano
# e por ambiente (teste/produção têm ids diferentes). Ver README.
MERCADOPAGO_PLAN_ID_BASICO=""
MERCADOPAGO_PLAN_ID_PRO=""

# Protege /api/cron/pix-renewals — a Vercel injeta esse header automaticamente
# em execuções agendadas (ver vercel.json) quando a env var tem esse nome exato.
CRON_SECRET="replace-with-a-random-secret"
