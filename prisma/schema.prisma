// ==========================================================
// Conecta Direito — Schema do banco de dados
//
// Modelo de negócio: assinatura mensal do advogado (acesso à
// plataforma), não pagamento por contato individual. O contato do
// cliente só é revelado ao advogado depois que o próprio cliente
// aceita explicitamente — ver InterestManifestation.contactReleasedAt.
// Isso evita o enquadramento como captação de clientela / mercantilização
// da advocacia (art. 39+ do Código de Ética da OAB, Provimento 205/2021).
// ==========================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ------------------------------------------------------------
// Enums
// ------------------------------------------------------------

enum UserRole {
  CLIENT
  LAWYER
  ADMIN
}

enum LegalArea {
  TRABALHISTA
  FAMILIA
  CONSUMIDOR
  CIVEL
  CRIMINAL
  EMPRESARIAL
  PREVIDENCIARIO
  TRIBUTARIO
  OUTROS
}

enum Urgency {
  BAIXA
  MEDIA
  ALTA
}

enum LeadStatus {
  OPEN // ainda pode receber manifestações de interesse
  CLOSED // atingiu o limite de manifestações (maxInterests)
  EXPIRED // ficou muito tempo sem manifestações / cancelado
}

enum SubscriptionPlan {
  BASICO
  PRO
}

enum SubscriptionStatus {
  PENDING // checkout iniciado, aguardando confirmação do gateway
  ACTIVE
  PAST_DUE // pagamento recorrente falhou, aguardando nova tentativa
  CANCELED
}

enum InterestStatus {
  PENDING // advogado manifestou, cliente ainda não respondeu
  ACCEPTED // cliente liberou o contato
  DECLINED // cliente optou por não liberar
}

enum NotificationType {
  LAWYER_INTEREST // cliente: um advogado manifestou interesse no seu caso
  CONTACT_ACCEPTED // advogado: cliente aceitou liberar o contato
  CONTACT_DECLINED // advogado: cliente recusou liberar o contato
}

// ------------------------------------------------------------
// Users (Clientes, Advogados e Admins)
// ------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  role         UserRole

  name         String
  email        String   @unique
  passwordHash String
  phone        String?

  // Dados específicos de cliente
  cpf          String?   @unique
  birthDate    DateTime?

  // Dados específicos de advogado — nome, OAB e cidade são exibidos
  // publicamente ao cliente quando o advogado manifesta interesse.
  // Único por OAB de registro (ex: "123456"/"SP") — não globalmente, já
  // que advogados de estados diferentes podem ter o mesmo número.
  oabNumber    String?
  oabState     String? // UF de registro na OAB, ex: "SP"

  areasOfPractice LegalArea[] @default([])
  activeRegions   String[]    @default([]) // cidades/UFs em que atua

  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  leads         Lead[] // casos abertos por este usuário, quando role = CLIENT
  subscriptions Subscription[] // histórico de assinaturas, quando role = LAWYER
  interests     InterestManifestation[]
  notifications Notification[]

  @@unique([oabNumber, oabState])
  @@index([role])
  @@map("users")
}

// ------------------------------------------------------------
// Leads (Causas cadastradas pelos clientes)
// ------------------------------------------------------------

model Lead {
  id          String     @id @default(cuid())

  // Conta do cliente que abriu o caso (para o painel "meus casos").
  // Os campos abaixo continuam duplicados no Lead de propósito: são um
  // retrato do caso no momento do envio, independente de mudanças futuras
  // na conta do cliente.
  clientId    String?
  client      User?      @relation(fields: [clientId], references: [id], onDelete: SetNull)

  // Dados sensíveis do cliente — NUNCA expor via API pública. Só chegam
  // ao advogado através de InterestManifestation.contactReleasedAt,
  // depois que o cliente aceita explicitamente aquele advogado específico.
  fullName    String
  cpf         String
  birthDate   DateTime
  phone       String
  email       String

  // Detalhes da causa — podem ser exibidos publicamente, de forma anônima
  // (identificados só pelo id/"Caso #...", nunca pelo nome do cliente)
  legalArea   LegalArea
  description String
  urgency     Urgency
  city        String
  state       String

  status        LeadStatus @default(OPEN)
  maxInterests  Int        @default(5) // limite de advogados que podem manifestar interesse

  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  interests   InterestManifestation[]

  @@index([status])
  @@index([legalArea, city])
  @@index([clientId])
  @@map("leads")
}

// ------------------------------------------------------------
// InterestManifestations (advogado manifesta interesse em uma causa;
// cliente decide se libera o contato para aquele advogado específico)
// ------------------------------------------------------------

model InterestManifestation {
  id                String          @id @default(cuid())

  leadId            String
  lead              Lead            @relation(fields: [leadId], references: [id], onDelete: Cascade)

  lawyerId          String
  lawyer            User            @relation(fields: [lawyerId], references: [id], onDelete: Cascade)

  status            InterestStatus  @default(PENDING)

  // Nulo até o cliente clicar em "Aceitar contato" para este advogado.
  // Só quando preenchido é que os dados sensíveis do Lead podem ser
  // exibidos a este advogado (ver lib/masking.ts).
  contactReleasedAt DateTime?
  respondedAt       DateTime?

  createdAt         DateTime        @default(now())

  // Um mesmo advogado não pode manifestar interesse duas vezes na mesma causa
  @@unique([leadId, lawyerId])
  @@index([lawyerId])
  @@index([leadId])
  @@map("interest_manifestations")
}

// ------------------------------------------------------------
// Subscriptions (assinatura mensal do advogado — dá acesso à
// plataforma e à visibilidade no mural de causas, não a leads individuais)
// ------------------------------------------------------------

model Subscription {
  id                     String              @id @default(cuid())

  lawyerId               String
  lawyer                 User                @relation(fields: [lawyerId], references: [id], onDelete: Cascade)

  plan                   SubscriptionPlan
  status                 SubscriptionStatus  @default(PENDING)
  priceBRL               Decimal             @db.Decimal(10, 2)

  startedAt              DateTime            @default(now())
  renewsAt               DateTime?
  canceledAt             DateTime?

  paymentProvider        String? // ex: "mercadopago"
  externalSubscriptionId String? // id da assinatura no gateway de pagamento

  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt

  @@index([lawyerId])
  @@index([status])
  @@map("subscriptions")
}

// ------------------------------------------------------------
// Notifications (eventos in-app — base para e-mail/push no futuro)
// ------------------------------------------------------------

model Notification {
  id        String           @id @default(cuid())

  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  message   String
  leadId    String? // referência informativa, sem relação obrigatória

  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}
